# Copy to `.env` for local development: cp .env.example .env
# On Replit these are provided by the Secrets manager — do not commit a real .env.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string. The `citext` extension must exist in this
# database (the seed script creates it, or run it manually:
#   CREATE EXTENSION IF NOT EXISTS citext;
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pds

# Session signing key — must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# ── Server ────────────────────────────────────────────────────────────────────

# API server port. The Replit artifact config pins this to 8080 in production.
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Public URL of the app, used to build invite and password-reset links.
APP_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call the API with
# credentials. Only needed when the frontend is served from a different origin
# than the API — in the Replit deployment both share one origin, so leave empty.
CORS_ORIGINS=http://localhost:5173

# ── i18n ──────────────────────────────────────────────────────────────────────

DEFAULT_LOCALE=uk
SUPPORTED_LOCALES=uk,cs

# ── Files & storage ───────────────────────────────────────────────────────────

FILE_MAX_BYTES=52428800
# Keep false in production until Replit App Storage and Dropbox are verified.
FILES_ENABLED=true

# Replit App Storage (staging tier). Required for file upload/download.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Dropbox archive tier (optional) ───────────────────────────────────────────
# Without these, file upload still works; the archive transfer job stays idle.

STORAGE_ARCHIVE_PROVIDER=dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=

# AES-256-GCM key encrypting the stored Dropbox refresh token. Minimum 32 chars.
# Required only when Dropbox is connected. Changing it invalidates the stored token.
ENCRYPTION_KEY=
# Keep this distinct from the session secret and never commit the real value.

# ── Email ─────────────────────────────────────────────────────────────────────
# `console` writes invite and reset links only in non-production environments.
# Production logs never contain raw account tokens and require SMTP delivery.

EMAIL_PROVIDER=console
SMTP_URL=
EMAIL_FROM=

# ── Messaging ─────────────────────────────────────────────────────────────────

MESSAGE_POLL_INTERVAL_MS=10000

# ── Seed script (artifacts/api-server/src/scripts/seed.ts) ────────────────────

SEED_ADMIN_EMAIL=admin@crm-solar.local
# Required by db:seed; use a unique password with at least 12 characters.
SEED_ADMIN_PASSWORD=
